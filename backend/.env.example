# Shared secret used to authenticate PC and mobile clients against the relay.
# Generate a long random string, e.g.:  python -c "import secrets; print(secrets.token_urlsafe(32))"
RELAY_SECRET=change-me-to-a-long-random-secret

# Optional: enables cross-instance Pub/Sub + presence (multi-instance Vercel deploys).
# When unset, a single-instance in-memory Pub/Sub is used.
# REDIS_URL=redis://localhost:6379/0

# Optional tuning (defaults shown):
# PRESENCE_TIMEOUT_SEC=15
# HEARTBEAT_INTERVAL_SEC=5
# PRESENCE_SWEEP_INTERVAL_SEC=3
# HOST=0.0.0.0
# PORT=8000
