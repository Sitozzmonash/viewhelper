# WebSocket relay endpoint the mobile web client connects to.
# Defaults to ws://localhost:8000/ws when empty.
# In production point this at the deployed FastAPI relay, e.g. wss://your-host/api/ws
NEXT_PUBLIC_RELAY_URL=ws://localhost:8000/ws

# Set to 1 to run the UI against the built-in mock transport (no relay needed).
# When NEXT_PUBLIC_RELAY_URL is empty the demo/mock transport is used automatically.
NEXT_PUBLIC_DEMO=0
