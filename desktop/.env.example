# ---------------------------------------------------------------------------
# viewhelper desktop configuration (copy to `desktop/.env`)
#
# Lookup order: environment variables > desktop/.env > repository root .env
# Legacy names (MODEL_API_KEY / MODEL_BASE_URL / MODEL_NAME) are accepted as
# fallbacks for LLM_API_KEY / LLM_BASE_URL / LLM_MODEL.
#
# NEVER commit the real .env and never log these values.
# ---------------------------------------------------------------------------

# --- Conversation LLM (OpenAI compatible /chat/completions) -----------------
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# Legacy aliases (used only when the LLM_* value above is empty)
# MODEL_API_KEY=
# MODEL_BASE_URL=
# MODEL_NAME=

# --- Vision LLM (falls back to LLM_* when left empty) ----------------------
VISION_API_KEY=
VISION_BASE_URL=
VISION_MODEL=

# --- Cloud WebSocket relay -------------------------------------------------
# The desktop app connects to  wss://<host>/ws  (the "/ws" path is appended
# automatically when RELAY_URL has no path).
RELAY_URL=wss://your-relay.example.com
RELAY_DEVICE_ID=my-pc
RELAY_ROOM=my-pc
# Shared secret validated by the relay (>= 32 random bytes). Sent only to the
# relay, never to the mobile client, never written to logs.
RELAY_SECRET=

# --- Misc ------------------------------------------------------------------
LOG_LEVEL=INFO
# Override the directory holding SQLite + screenshots (default: desktop/data)
# VIEWHELPER_DATA_DIR=
# Override the YAML config location (default: desktop/config.yaml)
# VIEWHELPER_CONFIG=
